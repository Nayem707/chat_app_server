# -------------------------------------------------------------------
# Server environment example — copy to `.env` and fill in real values.
# NEVER commit `.env`.
# -------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=5000
LOG_LEVEL=debug

# Database (MongoDB replica set is required for Prisma + MongoDB transactions)
# For local Docker: mongodb://root:example@localhost:27017/chat?authSource=admin&replicaSet=rs0
DATABASE_URL="mongodb://root:example@localhost:27017/chat?authSource=admin&replicaSet=rs0&directConnection=true"

# JWT
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookies
COOKIE_SECRET=replace-me-with-a-long-random-string
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false        # true in production behind HTTPS
COOKIE_SAMESITE=lax        # 'lax' for same-site, 'none' for cross-site (requires COOKIE_SECURE=true)

# CORS / Client
CLIENT_URL=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# File storage (Phase 7)
STORAGE_PROVIDER=local     # local | s3 | r2
STORAGE_LOCAL_DIR=./uploads
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_BASE_URL=
