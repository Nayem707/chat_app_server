// -----------------------------------------------------------------------------
// Prisma schema — MongoDB
//
// Design goals:
//   * Unified `Conversation` model for both DIRECT and GROUP chats.
//   * Membership modelled as a separate `ConversationMember` collection so we
//     get proper joins/indexes instead of unbounded embedded arrays.
//   * `Message` is normalized; `MessageRead` tracks per-user read receipts.
//   * Kept close to a relational shape so migration to Postgres later is realistic.
//   * No sensitive fields (password hashes) are ever selected by default in code;
//     `passwordHash` is only read inside the auth service.
// -----------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum ConversationType {
  DIRECT
  GROUP
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  SYSTEM
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

// ---------------------------------------------------------------------------
// User
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  email         String   @unique
  username      String   @unique
  displayName   String
  passwordHash  String
  avatarUrl     String?
  bio           String?

  isOnline      Boolean  @default(false)
  lastSeenAt    DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  memberships       ConversationMember[]
  sentMessages      Message[]            @relation("SentMessages")
  editedMessages    Message[]            @relation("EditedByUser")
  messageReads      MessageRead[]
  refreshTokens     RefreshToken[]
  ownedConversations Conversation[]      @relation("ConversationCreator")

  @@index([displayName])
}

// ---------------------------------------------------------------------------
// Refresh tokens (rotating, revocable)
// ---------------------------------------------------------------------------

model RefreshToken {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String   @unique
  familyId    String   // rotate detection: reuse of a revoked family = compromise
  userAgent   String?
  ipAddress   String?
  revokedAt   DateTime?
  replacedById String? @db.ObjectId
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Conversation
// ---------------------------------------------------------------------------

model Conversation {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  type        ConversationType
  name        String?          // GROUP only
  avatarUrl   String?          // GROUP only
  description String?          // GROUP only

  // For DIRECT conversations we store a sorted pair key to enforce uniqueness
  // (two users must not have two direct conversations between them).
  directKey   String?          @unique

  createdById String?          @db.ObjectId
  createdBy   User?            @relation("ConversationCreator", fields: [createdById], references: [id])

  lastMessageAt DateTime?      // for sidebar ordering; updated on new message

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  members  ConversationMember[]
  messages Message[]

  @@index([type])
  @@index([lastMessageAt])
}

// ---------------------------------------------------------------------------
// ConversationMember (join table)
// ---------------------------------------------------------------------------

model ConversationMember {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String       @db.ObjectId
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userId         String       @db.ObjectId
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  role           MemberRole   @default(MEMBER)

  joinedAt       DateTime     @default(now())
  leftAt         DateTime?
  lastReadAt     DateTime?    // used to compute unread counts efficiently
  mutedUntil     DateTime?

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
}

// ---------------------------------------------------------------------------
// Message
// ---------------------------------------------------------------------------

model Message {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String        @db.ObjectId
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId       String        @db.ObjectId
  sender         User          @relation("SentMessages", fields: [senderId], references: [id])

  type           MessageType   @default(TEXT)
  content        String?       // TEXT payload / caption for media
  attachmentUrl  String?
  attachmentName String?
  attachmentSize Int?
  attachmentMime String?

  status         MessageStatus @default(SENT)

  replyToId      String?       @db.ObjectId
  replyTo        Message?      @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies        Message[]     @relation("MessageReplies")

  editedAt       DateTime?
  editedById     String?       @db.ObjectId
  editedBy       User?         @relation("EditedByUser", fields: [editedById], references: [id])
  deletedAt      DateTime?     // soft delete

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  reads MessageRead[]

  @@index([conversationId, createdAt])
  @@index([senderId])
  // Full-text search on `content` is created as a MongoDB text index at startup
  // (see `server/prisma/mongo-indexes.js`) because Prisma's @@fulltext is MySQL-only.
}

// ---------------------------------------------------------------------------
// MessageRead (per-user read receipt)
// ---------------------------------------------------------------------------

model MessageRead {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  messageId String   @db.ObjectId
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt    DateTime @default(now())

  @@unique([messageId, userId])
  @@index([userId])
}
